<Window x:Class="ClaudeFromHereConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude From Here &#x2014; Settings"
        MinWidth="500" MinHeight="480"
        Width="520" Height="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://siteoforigin:,,,/settings.ico"
        Background="{StaticResource DominantBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4"
                      GlassFrameThickness="-1" CornerRadius="8"/>
    </WindowChrome.WindowChrome>
    <DockPanel>
        <!-- Custom title bar -->
        <Grid DockPanel.Dock="Top" Height="32" Background="{StaticResource DominantBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="pack://siteoforigin:,,,/settings.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Claude From Here &#x2014; Settings"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="MinButton_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="MaxButton_Click" ToolTip="Maximize"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
                        Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>
        <!-- Bottom button bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,16,16,16">
            <Button Content="Discard Changes" Width="110"
                    Style="{StaticResource SecondaryButton}"
                    Click="DiscardChanges_Click" Margin="0,0,8,0"/>
            <Button Content="Apply Settings" Width="110"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="ApplySettings_Click"/>
        </StackPanel>

        <!-- Tab control fills remaining space -->
        <TabControl Margin="16,0,16,0">
            <!-- General tab -->
            <TabItem Header="General">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Model -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Model:"
                               VerticalAlignment="Center"/>
                        <ComboBox x:Name="modelComboBox" Grid.Row="0" Grid.Column="1"
                                  IsEditable="False" Margin="0,0,0,8">
                            <ComboBoxItem Content="(default &#x2014; no flag)" IsSelected="True"/>
                            <ComboBoxItem Content="claude-opus-4-5"/>
                            <ComboBoxItem Content="claude-sonnet-4-5"/>
                            <ComboBoxItem Content="claude-haiku-3-5"/>
                            <ComboBoxItem Content="sonnet"/>
                            <ComboBoxItem Content="opus"/>
                            <ComboBoxItem Content="haiku"/>
                        </ComboBox>

                        <!-- Verbose -->
                        <CheckBox x:Name="verboseCheckBox" Grid.Row="1" Grid.Column="1"
                                  Content="Enable verbose mode (--verbose)" Margin="0,4,0,4"/>

                        <!-- Continue -->
                        <CheckBox x:Name="continueCheckBox" Grid.Row="2" Grid.Column="1"
                                  Content="-c  Continue the most recent conversation" Margin="0,4,0,4"/>

                        <!-- Resume -->
                        <CheckBox x:Name="resumeCheckBox" Grid.Row="3" Grid.Column="1"
                                  Content="-r  Resume a specific conversation" Margin="0,4,0,4"/>
                    </Grid>

                    <!-- Path Detection -->
                    <GroupBox Header="Path Detection" Margin="0,24,0,0" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="claude.exe:"/>
                            <TextBlock x:Name="claudePathText" Grid.Row="0" Grid.Column="1"
                                       FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,0,4"
                                       Text="Detecting..."/>

                            <Label Grid.Row="1" Grid.Column="0" Content="wt.exe:"/>
                            <TextBlock x:Name="wtPathText" Grid.Row="1" Grid.Column="1"
                                       FontFamily="Consolas" FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="Detecting..."/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Advanced tab -->
            <TabItem Header="Advanced">
                <StackPanel Margin="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Allowed Tools -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Allowed Tools:"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="allowedToolsTextBox" Grid.Row="0" Grid.Column="1"
                                 Margin="0,0,0,8"/>

                        <!-- Extra Flags -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Extra Flags:"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="extraFlagsTextBox" Grid.Row="1" Grid.Column="1"
                                 Margin="0,0,0,8"/>
                    </Grid>

                    <!-- Dangerous Permissions -->
                    <GroupBox Header="Dangerous Permissions" Margin="0,16,0,0" Padding="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <CheckBox x:Name="dangerSkipCheckBox" VerticalAlignment="Center"/>
                                <TextBlock Text="--dangerously-skip-permissions  Skip all permission checks"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <CheckBox x:Name="allowDangerSkipCheckBox" VerticalAlignment="Center"/>
                                <TextBlock Text="--allow-dangerously-skip-permissions  Allow MCP servers to skip permissions"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="These flags bypass Claude Code safety checks. Use only in controlled environments."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Remote control prefix -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Session prefix:"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="remotePrefixTextBox" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Providers tab -->
            <TabItem Header="Providers">
                <DockPanel Margin="16">
                    <!-- Add provider form -->
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Preset:"
                                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="providerPresetComboBox" Grid.Row="0" Grid.Column="1"
                                      Margin="0,0,0,8" SelectionChanged="ProviderPreset_Changed">
                                <ComboBoxItem Content="(custom)" IsSelected="True"/>
                                <ComboBoxItem Content="OpenRouter (Kimi K3)"/>
                                <ComboBoxItem Content="Kimi K2 (Moonshot)"/>
                                <ComboBoxItem Content="Qwen (DashScope)"/>
                                <ComboBoxItem Content="Local proxy (claude-code-router)"/>
                            </ComboBox>

                            <Label Grid.Row="1" Grid.Column="0" Content="Name:"
                                   VerticalAlignment="Center"/>
                            <TextBox x:Name="providerNameTextBox" Grid.Row="1" Grid.Column="1"
                                     Margin="0,0,0,8"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Base URL:"
                                   VerticalAlignment="Center"/>
                            <TextBox x:Name="providerBaseUrlTextBox" Grid.Row="2" Grid.Column="1"
                                     Margin="0,0,0,8"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Model:"
                                   VerticalAlignment="Center"/>
                            <TextBox x:Name="providerModelTextBox" Grid.Row="3" Grid.Column="1"
                                     Margin="0,0,0,8"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="Small model:"
                                   VerticalAlignment="Center"/>
                            <TextBox x:Name="providerSmallModelTextBox" Grid.Row="4" Grid.Column="1"
                                     Margin="0,0,0,8"
                                     ToolTip="Model for background/small-fast tasks. Empty = same as Model."/>

                            <Label Grid.Row="5" Grid.Column="0" Content="API key:"
                                   VerticalAlignment="Center"/>
                            <PasswordBox x:Name="providerKeyBox" Grid.Row="5" Grid.Column="1"
                                         Margin="0,0,0,8"/>

                            <Label Grid.Row="6" Grid.Column="0" Content="Effort:"
                                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="providerEffortComboBox" Grid.Row="6" Grid.Column="1"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="(default)" IsSelected="True"/>
                                <ComboBoxItem Content="low"/>
                                <ComboBoxItem Content="medium"/>
                                <ComboBoxItem Content="high"/>
                                <ComboBoxItem Content="xhigh"/>
                                <ComboBoxItem Content="max"/>
                            </ComboBox>

                            <Label Grid.Row="7" Grid.Column="0" Content="Tab color:"
                                   VerticalAlignment="Center"/>
                            <ComboBox x:Name="providerTabColorComboBox" Grid.Row="7" Grid.Column="1"
                                      IsEditable="True" Margin="0,0,0,8"
                                      ToolTip="Windows Terminal tab color for this profile (#RRGGBB). Empty = default.">
                                <ComboBoxItem Content=""/>
                                <ComboBoxItem Content="#E36209"/>
                                <ComboBoxItem Content="#2EA043"/>
                                <ComboBoxItem Content="#388BFD"/>
                                <ComboBoxItem Content="#A371F7"/>
                                <ComboBoxItem Content="#DA3633"/>
                            </ComboBox>

                            <Label Grid.Row="8" Grid.Column="0" Content="Extra flags:"
                                   VerticalAlignment="Center"/>
                            <TextBox x:Name="providerExtraFlagsTextBox" Grid.Row="8" Grid.Column="1"
                                     Margin="0,0,0,8"
                                     ToolTip="Appended after the global flags for this profile's launches."/>

                            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="providerContinueCheckBox" Content="-c" Margin="0,0,16,0"
                                          ToolTip="Continue the most recent conversation"/>
                                <CheckBox x:Name="providerResumeCheckBox" Content="-r" Margin="0,0,16,0"
                                          ToolTip="Resume a specific conversation"/>
                                <CheckBox x:Name="providerVerboseCheckBox" Content="--verbose"
                                          ToolTip="Enable verbose mode"/>
                            </StackPanel>

                            <Button Grid.Row="10" Grid.Column="1" Content="Add Provider"
                                    Style="{StaticResource AccentButton}"
                                    Click="AddProvider_Click"
                                    HorizontalAlignment="Right" Width="110" Margin="0,0,0,8"/>
                        </Grid>
                        <TextBlock Text="Providers appear as a flyout under 'Claude from here'. The endpoint must speak the Anthropic API. The API key is stored DPAPI-encrypted; leave it empty for local servers that need none."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,8" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Provider list -->
                    <ListBox x:Name="ProviderListBox" MinHeight="72">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Remove"
                                            DataContext="{Binding}"
                                            Click="RemoveProvider_Click"
                                            Width="60" Margin="4,0,0,0"/>
                                    <Button DockPanel.Dock="Right" Content="&#x25BC;"
                                            DataContext="{Binding}"
                                            Click="MoveProviderDown_Click"
                                            Width="24" Margin="4,0,0,0" ToolTip="Move down"/>
                                    <Button DockPanel.Dock="Right" Content="&#x25B2;"
                                            DataContext="{Binding}"
                                            Click="MoveProviderUp_Click"
                                            Width="24" Margin="4,0,0,0" ToolTip="Move up"/>
                                    <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Channels tab -->
            <TabItem Header="Channels">
                <DockPanel Margin="16">
                    <!-- Add channel row -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="channelComboBox" IsEditable="True" Width="350">
                            <ComboBoxItem Content="Telegram"/>
                            <ComboBoxItem Content="Discord"/>
                        </ComboBox>
                        <Button Content="Add" Style="{StaticResource AccentButton}"
                                Click="AddChannel_Click" Margin="8,0,0,0" Width="60"/>
                    </StackPanel>

                    <!-- Channel list -->
                    <ListBox x:Name="ChannelListBox" MinHeight="96">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Remove"
                                            DataContext="{Binding}"
                                            Click="RemoveChannel_Click"
                                            Width="60" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- Other tab -->
            <TabItem Header="Other">
                <StackPanel Margin="16">
                    <GroupBox Header="Effort levels in the menu" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Each enabled level adds an entry to the 'Claude from here' flyout that launches the default backend with that reasoning effort (--effort) for that session."
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <CheckBox x:Name="effortLowCheckBox"    Content="Low"        Margin="0,2"/>
                            <CheckBox x:Name="effortMediumCheckBox" Content="Medium"     Margin="0,2"/>
                            <CheckBox x:Name="effortHighCheckBox"   Content="High"       Margin="0,2"/>
                            <CheckBox x:Name="effortXhighCheckBox"  Content="Extra high" Margin="0,2"/>
                            <CheckBox x:Name="effortMaxCheckBox"    Content="Max"        Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
